-- =============================================
DROP VIEW IF EXISTS test_insert_view CASCADE;
NOTICE:  view "test_insert_view" does not exist, skipping
DROP TABLE IF EXISTS test_view_base CASCADE;
NOTICE:  table "test_view_base" does not exist, skipping
CREATE TABLE test_view_base (
    id INT PRIMARY KEY,
    category VARCHAR(20),
    value INT
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_view_base_pkey" for table "test_view_base"
CREATE VIEW test_insert_view AS
    SELECT id, category, value
    FROM test_view_base
    WHERE category = 'ACTIVE'
    WITH CHECK OPTION;
-- 17.1 Insert through view (valid)
INSERT INTO test_insert_view VALUES (1, 'ACTIVE', 100);
INSERT INTO test_insert_view VALUES (2, 'ACTIVE', 200);
