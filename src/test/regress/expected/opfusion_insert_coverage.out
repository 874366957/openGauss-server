-- =============================================
-- Section 19: Insert with Global Partition Index (GPI)
-- Covers: GPI handling in partitioned tables
-- =============================================
DROP TABLE IF EXISTS test_insert_gpi CASCADE;
NOTICE:  table "test_insert_gpi" does not exist, skipping
CREATE TABLE test_insert_gpi (
    id INT,
    category INT,
    value INT
)
PARTITION BY RANGE (category)
(
    PARTITION p1 VALUES LESS THAN (100),
    PARTITION p2 VALUES LESS THAN (200),
    PARTITION p3 VALUES LESS THAN (MAXVALUE)
);
-- Create global partition index
CREATE INDEX idx_gpi_global ON test_insert_gpi(id) GLOBAL;
-- 19.1 Insert with GPI
INSERT INTO test_insert_gpi VALUES (1, 50, 1000);
INSERT INTO test_insert_gpi VALUES (2, 150, 2000);
INSERT INTO test_insert_gpi VALUES (3, 250, 3000);
INSERT INTO test_insert_gpi VALUES (4, 75, 4000);
INSERT INTO test_insert_gpi VALUES (5, 175, 5000);
-- Verify results
SELECT * FROM test_insert_gpi ORDER BY id;
 id | category | value 
----+----------+-------
  1 |       50 |  1000
  2 |      150 |  2000
  3 |      250 |  3000
  4 |       75 |  4000
  5 |      175 |  5000
(5 rows)

