-- =============================================
-- Section 16: Insert with Triggers
-- Covers: ExecBRInsertTriggers, ExecARInsertTriggers
-- =============================================
DROP TABLE IF EXISTS test_insert_trigger CASCADE;
NOTICE:  table "test_insert_trigger" does not exist, skipping
DROP TABLE IF EXISTS test_trigger_log CASCADE;
NOTICE:  table "test_trigger_log" does not exist, skipping
CREATE TABLE test_trigger_log (
    log_id SERIAL,
    action VARCHAR(50),
    old_id INT,
    new_id INT,
    log_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
NOTICE:  CREATE TABLE will create implicit sequence "test_trigger_log_log_id_seq" for serial column "test_trigger_log.log_id"
CREATE TABLE test_insert_trigger (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    value INT
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_insert_trigger_pkey" for table "test_insert_trigger"
-- Create BEFORE INSERT trigger
CREATE OR REPLACE FUNCTION before_insert_func() RETURNS TRIGGER AS $$
BEGIN
    NEW.value := COALESCE(NEW.value, 0) + 10;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER before_insert_trigger
    BEFORE INSERT ON test_insert_trigger
    FOR EACH ROW
    EXECUTE PROCEDURE before_insert_func();
-- Create AFTER INSERT trigger
CREATE OR REPLACE FUNCTION after_insert_func() RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO test_trigger_log(action, new_id) VALUES ('INSERT', NEW.id);
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER after_insert_trigger
    AFTER INSERT ON test_insert_trigger
    FOR EACH ROW
    EXECUTE PROCEDURE after_insert_func();
-- 16.1 Insert with triggers
INSERT INTO test_insert_trigger VALUES (1, 'trigger1', 100);
INSERT INTO test_insert_trigger VALUES (2, 'trigger2', 200);
INSERT INTO test_insert_trigger VALUES (3, 'trigger3', NULL);
-- Verify results
SELECT * FROM test_insert_trigger ORDER BY id;
 id |   name   | value 
----+----------+-------
  1 | trigger1 |   110
  2 | trigger2 |   210
  3 | trigger3 |    10
(3 rows)

SELECT * FROM test_trigger_log ORDER BY log_id;
 log_id | action | old_id | new_id |          log_time          
--------+--------+--------+--------+----------------------------
      1 | INSERT |        |      1 | 
      2 | INSERT |        |      2 | 
      3 | INSERT |        |      3 | 
(3 rows)

