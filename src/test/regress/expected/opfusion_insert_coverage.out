--
-- Test cases for Insert operations in ModifyTable and OpFusion
-- Covers all non-exception branches in nodeModifyTable.cpp and opfusion_insert.cpp
--
-- Setup: Enable opfusion and related settings
SET enable_opfusion = on;
SET enable_partition_opfusion = on;
SET enable_bitmapscan = off;
SET enable_seqscan = off;
SET opfusion_debug_mode = 'log';
SET log_min_messages = debug;
SET logging_module = 'on(OPFUSION)';
SET sql_beta_feature = 'index_cost_with_leaf_pages_only';
-- =============================================
-- Section 1: Basic InsertFusion - Simple INSERT VALUES
-- Covers: InsertFusion::ExecInsert, InsertFusion::execute
-- =============================================
DROP TABLE IF EXISTS test_insert_basic CASCADE;
NOTICE:  table "test_insert_basic" does not exist, skipping
CREATE TABLE test_insert_basic (
    id INT,
    name VARCHAR(50),
    value NUMERIC(10,2),
    created_at TIMESTAMP
);
CREATE INDEX idx_insert_basic ON test_insert_basic(id);
-- 1.1 Basic insert with all columns
EXPLAIN INSERT INTO test_insert_basic VALUES (1, 'test1', 100.50, '2024-01-01 10:00:00');
                           QUERY PLAN                           
----------------------------------------------------------------
 [Bypass]
 Insert on test_insert_basic  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_basic VALUES (1, 'test1', 100.50, '2024-01-01 10:00:00');
-- 1.2 Insert with specified columns
EXPLAIN INSERT INTO test_insert_basic(id, name) VALUES (2, 'test2');
                           QUERY PLAN                           
----------------------------------------------------------------
 [Bypass]
 Insert on test_insert_basic  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_basic(id, name) VALUES (2, 'test2');
-- 1.3 Insert with NULL values
EXPLAIN INSERT INTO test_insert_basic VALUES (3, NULL, NULL, NULL);
                           QUERY PLAN                           
----------------------------------------------------------------
 [Bypass]
 Insert on test_insert_basic  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_basic VALUES (3, NULL, NULL, NULL);
-- 1.4 Insert with constants only
EXPLAIN INSERT INTO test_insert_basic VALUES (4, 'constant_test', 999.99, '2024-12-31 23:59:59');
                           QUERY PLAN                           
----------------------------------------------------------------
 [Bypass]
 Insert on test_insert_basic  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_basic VALUES (4, 'constant_test', 999.99, '2024-12-31 23:59:59');
-- Verify results
SELECT * FROM test_insert_basic ORDER BY id;
 id |     name      |  value  |      created_at      
----+---------------+---------+----------------------
  1 | test1         |  100.50 | 2024-01-01 10:00:00
  2 | test2         |         | 
  3 |               |         | 
  4 | constant_test |  999.99 | 2024-12-31 23:59:59
(4 rows)

-- =============================================
-- Section 2: InsertFusion with Constraints
-- Covers: ExecConstraints, NOT NULL, CHECK constraints
-- =============================================
DROP TABLE IF EXISTS test_insert_constraints CASCADE;
NOTICE:  table "test_insert_constraints" does not exist, skipping
CREATE TABLE test_insert_constraints (
    id INT NOT NULL,
    name VARCHAR(50) NOT NULL,
    age INT CHECK (age >= 0 AND age <= 150),
    email VARCHAR(100) DEFAULT 'default@test.com'
);
CREATE INDEX idx_insert_constraints ON test_insert_constraints(id);
-- 2.1 Insert with NOT NULL constraint satisfied
EXPLAIN INSERT INTO test_insert_constraints(id, name, age) VALUES (1, 'John', 30);
                              QUERY PLAN                              
----------------------------------------------------------------------
 [Bypass]
 Insert on test_insert_constraints  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_constraints(id, name, age) VALUES (1, 'John', 30);
-- 2.2 Insert with CHECK constraint satisfied
INSERT INTO test_insert_constraints(id, name, age) VALUES (2, 'Jane', 25);
-- 2.3 Insert using default value
EXPLAIN INSERT INTO test_insert_constraints(id, name, age) VALUES (3, 'Bob', 40);
                              QUERY PLAN                              
----------------------------------------------------------------------
 [Bypass]
 Insert on test_insert_constraints  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_constraints(id, name, age) VALUES (3, 'Bob', 40);
-- 2.4 Insert with explicit default value
INSERT INTO test_insert_constraints VALUES (4, 'Alice', 35, DEFAULT);
-- Verify results
SELECT * FROM test_insert_constraints ORDER BY id;
 id | name  | age |      email       
----+-------+-----+------------------
  1 | John  |  30 | default@test.com
  2 | Jane  |  25 | default@test.com
  3 | Bob   |  40 | default@test.com
  4 | Alice |  35 | default@test.com
(4 rows)

-- =============================================
-- Section 3: InsertFusion with Index Operations
-- Covers: ExecInsertIndexTuples, unique index handling
-- =============================================
DROP TABLE IF EXISTS test_insert_index CASCADE;
NOTICE:  table "test_insert_index" does not exist, skipping
CREATE TABLE test_insert_index (
    id INT PRIMARY KEY,
    unique_col VARCHAR(50) UNIQUE,
    indexed_col INT,
    data TEXT
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_insert_index_pkey" for table "test_insert_index"
NOTICE:  CREATE TABLE / UNIQUE will create implicit index "test_insert_index_unique_col_key" for table "test_insert_index"
CREATE INDEX idx_insert_indexed ON test_insert_index(indexed_col);
-- 3.1 Insert with primary key
EXPLAIN INSERT INTO test_insert_index VALUES (1, 'unique1', 100, 'data1');
                          QUERY PLAN                           
---------------------------------------------------------------
 [Bypass]
 Insert on test_insert_index  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_index VALUES (1, 'unique1', 100, 'data1');
-- 3.2 Insert with unique constraint
INSERT INTO test_insert_index VALUES (2, 'unique2', 200, 'data2');
-- 3.3 Insert with indexed column
INSERT INTO test_insert_index VALUES (3, 'unique3', 100, 'data3');
-- 3.4 Multiple inserts with different indexed values
INSERT INTO test_insert_index VALUES (4, 'unique4', 300, 'data4');
INSERT INTO test_insert_index VALUES (5, 'unique5', 400, 'data5');
-- Verify results
SELECT * FROM test_insert_index ORDER BY id;
 id | unique_col | indexed_col | data  
----+------------+-------------+-------
  1 | unique1    |         100 | data1
  2 | unique2    |         200 | data2
  3 | unique3    |         100 | data3
  4 | unique4    |         300 | data4
  5 | unique5    |         400 | data5
(5 rows)

-- =============================================
-- Section 4: InsertFusion with Partition Tables (RANGE)
-- Covers: RELATION_IS_PARTITIONED, heapTupleGetPartitionOid
-- =============================================
DROP TABLE IF EXISTS test_insert_partition_range CASCADE;
NOTICE:  table "test_insert_partition_range" does not exist, skipping
CREATE TABLE test_insert_partition_range (
    id INT,
    category INT,
    value NUMERIC(10,2),
    description VARCHAR(100)
)
PARTITION BY RANGE (category)
(
    PARTITION p1 VALUES LESS THAN (10),
    PARTITION p2 VALUES LESS THAN (20),
    PARTITION p3 VALUES LESS THAN (30),
    PARTITION p4 VALUES LESS THAN (MAXVALUE)
);
CREATE INDEX idx_partition_range ON test_insert_partition_range(id) LOCAL;
-- 4.1 Insert into first partition
EXPLAIN INSERT INTO test_insert_partition_range VALUES (1, 5, 100.00, 'partition_p1');
                                 QUERY PLAN                                  
-----------------------------------------------------------------------------
 [Bypass]
 Insert on test_insert_partition_range  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_partition_range VALUES (1, 5, 100.00, 'partition_p1');
-- 4.2 Insert into second partition
INSERT INTO test_insert_partition_range VALUES (2, 15, 200.00, 'partition_p2');
-- 4.3 Insert into third partition
INSERT INTO test_insert_partition_range VALUES (3, 25, 300.00, 'partition_p3');
-- 4.4 Insert into maxvalue partition
INSERT INTO test_insert_partition_range VALUES (4, 100, 400.00, 'partition_p4');
-- 4.5 Insert boundary values
INSERT INTO test_insert_partition_range VALUES (5, 9, 500.00, 'boundary_p1');
INSERT INTO test_insert_partition_range VALUES (6, 10, 600.00, 'boundary_p2');
INSERT INTO test_insert_partition_range VALUES (7, 19, 700.00, 'boundary_p2');
INSERT INTO test_insert_partition_range VALUES (8, 20, 800.00, 'boundary_p3');
-- Verify results
SELECT * FROM test_insert_partition_range ORDER BY id;
 id | category |  value  | description  
----+----------+---------+--------------
  1 |        5 |  100.00 | partition_p1
  2 |       15 |  200.00 | partition_p2
  3 |       25 |  300.00 | partition_p3
  4 |      100 |  400.00 | partition_p4
  5 |        9 |  500.00 | boundary_p1
  6 |       10 |  600.00 | boundary_p2
  7 |       19 |  700.00 | boundary_p2
  8 |       20 |  800.00 | boundary_p3
(8 rows)

-- =============================================
-- Section 5: InsertFusion with LIST Partition
-- Covers: LIST partition handling in ModifyTable
-- =============================================
DROP TABLE IF EXISTS test_insert_partition_list CASCADE;
NOTICE:  table "test_insert_partition_list" does not exist, skipping
CREATE TABLE test_insert_partition_list (
    id INT,
    region VARCHAR(20),
    amount NUMERIC(10,2)
)
PARTITION BY LIST (region)
(
    PARTITION p_east VALUES ('EAST', 'E'),
    PARTITION p_west VALUES ('WEST', 'W'),
    PARTITION p_north VALUES ('NORTH', 'N'),
    PARTITION p_south VALUES ('SOUTH', 'S'),
    PARTITION p_default VALUES (DEFAULT)
);
CREATE INDEX idx_partition_list ON test_insert_partition_list(id) LOCAL;
-- 5.1 Insert into each list partition
INSERT INTO test_insert_partition_list VALUES (1, 'EAST', 1000.00);
INSERT INTO test_insert_partition_list VALUES (2, 'WEST', 2000.00);
INSERT INTO test_insert_partition_list VALUES (3, 'NORTH', 3000.00);
INSERT INTO test_insert_partition_list VALUES (4, 'SOUTH', 4000.00);
INSERT INTO test_insert_partition_list VALUES (5, 'E', 500.00);
INSERT INTO test_insert_partition_list VALUES (6, 'W', 600.00);
-- 5.2 Insert into default partition
INSERT INTO test_insert_partition_list VALUES (7, 'CENTER', 7000.00);
-- Verify results
SELECT * FROM test_insert_partition_list ORDER BY id;
 id | region |  amount  
----+--------+----------
  1 | EAST   |  1000.00
  2 | WEST   |  2000.00
  3 | NORTH  |  3000.00
  4 | SOUTH  |  4000.00
  5 | E      |   500.00
  6 | W      |   600.00
  7 | CENTER |  7000.00
(7 rows)

-- =============================================
-- Section 6: InsertFusion with HASH Partition
-- Covers: HASH partition handling
-- =============================================
DROP TABLE IF EXISTS test_insert_partition_hash CASCADE;
NOTICE:  table "test_insert_partition_hash" does not exist, skipping
CREATE TABLE test_insert_partition_hash (
    id INT,
    customer_id INT,
    order_amount NUMERIC(10,2)
)
PARTITION BY HASH (customer_id)
(
    PARTITION p0,
    PARTITION p1,
    PARTITION p2,
    PARTITION p3
);
CREATE INDEX idx_partition_hash ON test_insert_partition_hash(id) LOCAL;
-- 6.1 Insert into hash partitions
INSERT INTO test_insert_partition_hash VALUES (1, 100, 1000.00);
INSERT INTO test_insert_partition_hash VALUES (2, 101, 2000.00);
INSERT INTO test_insert_partition_hash VALUES (3, 102, 3000.00);
INSERT INTO test_insert_partition_hash VALUES (4, 103, 4000.00);
INSERT INTO test_insert_partition_hash VALUES (5, 200, 5000.00);
INSERT INTO test_insert_partition_hash VALUES (6, 201, 6000.00);
-- Verify results
SELECT * FROM test_insert_partition_hash ORDER BY id;
 id | customer_id | order_amount 
----+-------------+--------------
  1 |         100 |      1000.00
  2 |         101 |      2000.00
  3 |         102 |      3000.00
  4 |         103 |      4000.00
  5 |         200 |      5000.00
  6 |         201 |      6000.00
(6 rows)

-- =============================================
-- Section 7: InsertFusion with Subpartitions
-- Covers: RelationIsSubPartitioned, heapTupleGetSubPartitionOid
-- =============================================
DROP TABLE IF EXISTS test_insert_subpartition CASCADE;
NOTICE:  table "test_insert_subpartition" does not exist, skipping
CREATE TABLE test_insert_subpartition (
    id INT,
    region VARCHAR(20),
    category INT,
    amount NUMERIC(10,2)
)
PARTITION BY LIST (region)
SUBPARTITION BY RANGE (category)
(
    PARTITION p_east VALUES ('EAST')
    (
        SUBPARTITION p_east_low VALUES LESS THAN (100),
        SUBPARTITION p_east_mid VALUES LESS THAN (500),
        SUBPARTITION p_east_high VALUES LESS THAN (MAXVALUE)
    ),
    PARTITION p_west VALUES ('WEST')
    (
        SUBPARTITION p_west_low VALUES LESS THAN (100),
        SUBPARTITION p_west_mid VALUES LESS THAN (500),
        SUBPARTITION p_west_high VALUES LESS THAN (MAXVALUE)
    )
);
CREATE INDEX idx_subpartition ON test_insert_subpartition(id) LOCAL;
-- 7.1 Insert into different subpartitions
INSERT INTO test_insert_subpartition VALUES (1, 'EAST', 50, 1000.00);
INSERT INTO test_insert_subpartition VALUES (2, 'EAST', 200, 2000.00);
INSERT INTO test_insert_subpartition VALUES (3, 'EAST', 600, 3000.00);
INSERT INTO test_insert_subpartition VALUES (4, 'WEST', 75, 4000.00);
INSERT INTO test_insert_subpartition VALUES (5, 'WEST', 300, 5000.00);
INSERT INTO test_insert_subpartition VALUES (6, 'WEST', 700, 6000.00);
-- Verify results
SELECT * FROM test_insert_subpartition ORDER BY id;
 id | region | category |  amount  
----+--------+----------+----------
  1 | EAST   |       50 |  1000.00
  2 | EAST   |      200 |  2000.00
  3 | EAST   |      600 |  3000.00
  4 | WEST   |       75 |  4000.00
  5 | WEST   |      300 |  5000.00
  6 | WEST   |      700 |  6000.00
(6 rows)

-- =============================================
-- Section 8: InsertFusion with Function Expressions
-- Covers: FuncExpr, CalFuncNodeVal
-- =============================================
DROP TABLE IF EXISTS test_insert_func CASCADE;
NOTICE:  table "test_insert_func" does not exist, skipping
CREATE TABLE test_insert_func (
    id INT,
    computed_col INT,
    text_col VARCHAR(100),
    date_col DATE
);
CREATE INDEX idx_insert_func ON test_insert_func(id);
-- 8.1 Insert with arithmetic expression
EXPLAIN INSERT INTO test_insert_func VALUES (1, 10 + 20, 'expr_test', '2024-01-01');
                        QUERY PLAN                         
-----------------------------------------------------------
 [Bypass]
 Insert on test_insert_func  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_func VALUES (1, 10 + 20, 'expr_test', '2024-01-01');
-- 8.2 Insert with mod function
INSERT INTO test_insert_func VALUES (2, mod(100, 7), 'mod_test', '2024-01-02');
-- 8.3 Insert with string concatenation (implicit function)
INSERT INTO test_insert_func VALUES (3, 30, 'hello' || '_world', '2024-01-03');
-- Verify results
SELECT * FROM test_insert_func ORDER BY id;
 id | computed_col |   text_col   |  date_col  
----+--------------+--------------+------------
  1 |           30 | expr_test    | 2024-01-01
  2 |            2 | mod_test     | 2024-01-02
  3 |           30 | hello_world  | 2024-01-03
(3 rows)

-- =============================================
-- Section 9: InsertFusion with Default Values
-- Covers: Default value handling, InitBaseParam
-- =============================================
DROP TABLE IF EXISTS test_insert_default CASCADE;
NOTICE:  table "test_insert_default" does not exist, skipping
CREATE TABLE test_insert_default (
    id INT,
    status INT DEFAULT 0,
    name VARCHAR(50) DEFAULT 'default_name',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    counter SERIAL
);
NOTICE:  CREATE TABLE will create implicit sequence "test_insert_default_counter_seq" for serial column "test_insert_default.counter"
CREATE INDEX idx_insert_default ON test_insert_default(id);
-- 9.1 Insert with all defaults
EXPLAIN INSERT INTO test_insert_default(id) VALUES (1);
                          QUERY PLAN                           
---------------------------------------------------------------
 Insert on test_insert_default  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(2 rows)

INSERT INTO test_insert_default(id) VALUES (1);
-- 9.2 Insert with explicit DEFAULT keyword
INSERT INTO test_insert_default VALUES (2, DEFAULT, DEFAULT, DEFAULT, DEFAULT);
-- 9.3 Insert with partial defaults
INSERT INTO test_insert_default(id, name) VALUES (3, 'custom_name');
-- Verify results
SELECT id, status, name, counter FROM test_insert_default ORDER BY id;
 id | status |     name     | counter 
----+--------+--------------+---------
  1 |      0 | default_name |       1
  2 |      0 | default_name |       2
  3 |      0 | custom_name  |       3
(3 rows)

-- =============================================
-- Section 10: InsertFusion with Generated Columns
-- Covers: ExecComputeStoredGenerated
-- =============================================
DROP TABLE IF EXISTS test_insert_generated CASCADE;
NOTICE:  table "test_insert_generated" does not exist, skipping
CREATE TABLE test_insert_generated (
    id INT,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    full_name VARCHAR(100) GENERATED ALWAYS AS (first_name || ' ' || last_name) STORED
);
CREATE INDEX idx_insert_generated ON test_insert_generated(id);
-- 10.1 Insert with generated column
EXPLAIN INSERT INTO test_insert_generated(id, first_name, last_name) VALUES (1, 'John', 'Doe');
                            QUERY PLAN                            
------------------------------------------------------------------
 [Bypass]
 Insert on test_insert_generated  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
(3 rows)

INSERT INTO test_insert_generated(id, first_name, last_name) VALUES (1, 'John', 'Doe');
-- 10.2 Multiple inserts with generated column
INSERT INTO test_insert_generated(id, first_name, last_name) VALUES (2, 'Jane', 'Smith');
INSERT INTO test_insert_generated(id, first_name, last_name) VALUES (3, 'Bob', 'Johnson');
-- Verify results
SELECT * FROM test_insert_generated ORDER BY id;
 id | first_name | last_name |  full_name   
----+------------+-----------+--------------
  1 | John       | Doe       | John Doe
  2 | Jane       | Smith     | Jane Smith
  3 | Bob        | Johnson   | Bob Johnson
(3 rows)

-- =============================================
-- Section 11: InsertSubFusion - INSERT ... SELECT
-- Covers: InsertSubFusion::ExecInsert, insert_real
-- =============================================
DROP TABLE IF EXISTS test_insert_select_src CASCADE;
NOTICE:  table "test_insert_select_src" does not exist, skipping
DROP TABLE IF EXISTS test_insert_select_dst CASCADE;
NOTICE:  table "test_insert_select_dst" does not exist, skipping
CREATE TABLE test_insert_select_src (
    id INT,
    name VARCHAR(50),
    value INT
);
CREATE INDEX idx_src ON test_insert_select_src(id);
CREATE TABLE test_insert_select_dst (
    id INT,
    name VARCHAR(50),
    value INT
);
CREATE INDEX idx_dst ON test_insert_select_dst(id);
-- Populate source table
INSERT INTO test_insert_select_src VALUES (1, 'src1', 100);
INSERT INTO test_insert_select_src VALUES (2, 'src2', 200);
INSERT INTO test_insert_select_src VALUES (3, 'src3', 300);
INSERT INTO test_insert_select_src VALUES (4, 'src4', 400);
INSERT INTO test_insert_select_src VALUES (5, 'src5', 500);
-- 11.1 INSERT ... SELECT basic
EXPLAIN INSERT INTO test_insert_select_dst SELECT * FROM test_insert_select_src WHERE id <= 3;
                                       QUERY PLAN                                       
----------------------------------------------------------------------------------------
 Insert on test_insert_select_dst  (cost=0.00..8.27 rows=1 width=86)
   ->  Index Scan using idx_src on test_insert_select_src  (cost=0.00..8.27 rows=1 width=86)
         Index Cond: (id <= 3)
(3 rows)

INSERT INTO test_insert_select_dst SELECT * FROM test_insert_select_src WHERE id <= 3;
-- 11.2 INSERT ... SELECT with filter
INSERT INTO test_insert_select_dst SELECT * FROM test_insert_select_src WHERE value > 300;
-- Verify results
SELECT * FROM test_insert_select_dst ORDER BY id;
 id | name | value 
----+------+-------
  1 | src1 |   100
  2 | src2 |   200
  3 | src3 |   300
  4 | src4 |   400
  5 | src5 |   500
(5 rows)

-- =============================================
-- Section 12: Insert with RETURNING clause
-- Covers: ExecProcessReturning
-- =============================================
DROP TABLE IF EXISTS test_insert_returning CASCADE;
NOTICE:  table "test_insert_returning" does not exist, skipping
CREATE TABLE test_insert_returning (
    id SERIAL PRIMARY KEY,
    name VARCHAR(50),
    value INT
);
NOTICE:  CREATE TABLE will create implicit sequence "test_insert_returning_id_seq" for serial column "test_insert_returning.id"
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_insert_returning_pkey" for table "test_insert_returning"
-- 12.1 Insert with RETURNING *
INSERT INTO test_insert_returning(name, value) VALUES ('ret1', 100) RETURNING *;
 id | name | value 
----+------+-------
  1 | ret1 |   100
(1 row)

-- 12.2 Insert with RETURNING specific columns
INSERT INTO test_insert_returning(name, value) VALUES ('ret2', 200) RETURNING id, name;
 id | name 
----+------
  2 | ret2
(1 row)

-- 12.3 Insert with RETURNING expression
INSERT INTO test_insert_returning(name, value) VALUES ('ret3', 300) RETURNING id, name, value * 2 AS doubled_value;
 id | name | doubled_value 
----+------+---------------
  3 | ret3 |           600
(1 row)

-- =============================================
-- Section 13: Insert with ON DUPLICATE KEY UPDATE (UPSERT)
-- Covers: ExecUpsert, ExecConflictUpdate
-- =============================================
DROP TABLE IF EXISTS test_upsert CASCADE;
NOTICE:  table "test_upsert" does not exist, skipping
CREATE TABLE test_upsert (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    counter INT DEFAULT 0
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_upsert_pkey" for table "test_upsert"
-- 13.1 Initial insert
INSERT INTO test_upsert VALUES (1, 'first', 1) ON DUPLICATE KEY UPDATE counter = counter + 1;
-- 13.2 Update on duplicate
INSERT INTO test_upsert VALUES (1, 'first', 1) ON DUPLICATE KEY UPDATE counter = counter + 1;
-- 13.3 New insert (no conflict)
INSERT INTO test_upsert VALUES (2, 'second', 1) ON DUPLICATE KEY UPDATE counter = counter + 1;
-- 13.4 Multiple upserts
INSERT INTO test_upsert VALUES (2, 'second', 1) ON DUPLICATE KEY UPDATE counter = counter + 1;
INSERT INTO test_upsert VALUES (3, 'third', 1) ON DUPLICATE KEY UPDATE counter = counter + 1;
-- Verify results
SELECT * FROM test_upsert ORDER BY id;
 id |  name  | counter 
----+--------+---------
  1 | first  |       2
  2 | second |       2
  3 | third  |       1
(3 rows)

-- =============================================
-- Section 14: Insert with IGNORE keyword
-- Covers: hasIgnore branch, SQL_OVERWRITE_NULL
-- =============================================
DROP TABLE IF EXISTS test_insert_ignore CASCADE;
NOTICE:  table "test_insert_ignore" does not exist, skipping
CREATE TABLE test_insert_ignore (
    id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    value INT
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_insert_ignore_pkey" for table "test_insert_ignore"
-- 14.1 Normal insert
INSERT INTO test_insert_ignore VALUES (1, 'test1', 100);
-- 14.2 Insert ignore with duplicate key (should warn but not fail)
INSERT /*+ IGNORE */ INTO test_insert_ignore VALUES (1, 'test1_dup', 100);
WARNING:  duplicate key value violates unique constraint in table "test_insert_ignore"
-- 14.3 Insert with unique constraint
INSERT INTO test_insert_ignore VALUES (2, 'test2', 200);
INSERT /*+ IGNORE */ INTO test_insert_ignore VALUES (2, 'test2_dup', 200);
WARNING:  duplicate key value violates unique constraint in table "test_insert_ignore"
-- Verify results
SELECT * FROM test_insert_ignore ORDER BY id;
 id | name  | value 
----+-------+-------
  1 | test1 |   100
  2 | test2 |   200
(2 rows)

-- =============================================
-- Section 15: Insert with USTORE (UStore table format)
-- Covers: TAM_USTORE handling
-- =============================================
DROP TABLE IF EXISTS test_insert_ustore CASCADE;
NOTICE:  table "test_insert_ustore" does not exist, skipping
CREATE TABLE test_insert_ustore (
    id INT,
    name VARCHAR(50),
    value INT
) WITH (STORAGE_TYPE = USTORE);
CREATE INDEX idx_ustore ON test_insert_ustore(id);
-- 15.1 Basic insert into USTORE table
EXPLAIN INSERT INTO test_insert_ustore VALUES (1, 'ustore1', 100);
                          QUERY PLAN                           
---------------------------------------------------------------
 [Bypass]
 Insert on test_insert_ustore  (cost=0.00..0.01 rows=1 width=0)
   ->  Result  (cost=0.00..0.01 rows=1 width=0)
