-- =============================================
DROP TABLE IF EXISTS test_insert_param CASCADE;
NOTICE:  table "test_insert_param" does not exist, skipping
CREATE TABLE test_insert_param (
    id INT,
    name VARCHAR(50),
    value INT
);
CREATE INDEX idx_insert_param ON test_insert_param(id);
-- 18.1 Prepare and execute with parameters
PREPARE insert_param_stmt (INT, VARCHAR, INT) AS
    INSERT INTO test_insert_param VALUES ($1, $2, $3);
EXECUTE insert_param_stmt(1, 'param1', 100);
EXECUTE insert_param_stmt(2, 'param2', 200);
EXECUTE insert_param_stmt(3, 'param3', 300);
DEALLOCATE insert_param_stmt;
