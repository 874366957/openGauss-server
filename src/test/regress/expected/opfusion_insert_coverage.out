-- =============================================
-- Section 25: Insert ReuseFusion
-- Covers: InsertFusion::ResetReuseFusion
-- =============================================
SET enable_opfusion_reuse = on;
DROP TABLE IF EXISTS test_insert_reuse1 CASCADE;
NOTICE:  table "test_insert_reuse1" does not exist, skipping
DROP TABLE IF EXISTS test_insert_reuse2 CASCADE;
NOTICE:  table "test_insert_reuse2" does not exist, skipping
CREATE TABLE test_insert_reuse1 (a INT, b INT, c TEXT);
CREATE TABLE test_insert_reuse2 (a INT, b INT, c TEXT, d TEXT);
-- 25.1 Multiple inserts to trigger reuse
BEGIN;
INSERT INTO test_insert_reuse1 VALUES (1, 1, 'test1');
INSERT INTO test_insert_reuse1 VALUES (2, 2, 'test2');
INSERT INTO test_insert_reuse2 VALUES (1, 1, 'test1', 'extra1');
INSERT INTO test_insert_reuse1 VALUES (3, 3, 'test3');
SELECT * FROM test_insert_reuse1 ORDER BY a;
 a | b |   c   
---+---+-------
 1 | 1 | test1
 2 | 2 | test2
 3 | 3 | test3
(3 rows)

SELECT * FROM test_insert_reuse2 ORDER BY a;
 a | b |   c   |   d    
---+---+-------+--------
 1 | 1 | test1 | extra1
(1 row)

COMMIT;
RESET enable_opfusion_reuse;
